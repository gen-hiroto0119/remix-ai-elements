{
  "$schema": "./node_modules/remix/schema/remix.json",
  "assets": {
    "rootDir": ".",
    "basePath": "/assets",
    "mounts": {
      "app": "app",
      "npm": "../../node_modules",
      "shared": "../shared"
    },
    "allowFiles": ["app/**/public/**", "../shared/fixtures.ts"],
    "allowPackages": ["remix", "remix-ai-elements"],
    "denyFiles": ["**/*.test.*"]
  }
}
