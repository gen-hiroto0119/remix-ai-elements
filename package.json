{
  "name": "remix-ai-elements-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm --filter remix-ai-elements build && pnpm --filter playground build && pnpm --filter shadcn-reference build",
    "typecheck": "pnpm -r exec tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json node --import tsx --test tests/*.test.tsx",
    "test:consumer": "node tests/package-consumer.mjs",
    "dev": "pnpm --filter playground dev",
    "dev:reference": "pnpm --filter shadcn-reference dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/node": "24.0.0",
    "remix": "3.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.3"
  }
}
