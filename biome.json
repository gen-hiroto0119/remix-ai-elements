{
  "$schema": "https://biomejs.dev/schemas/2.3.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!examples/shadcn-reference/src/components/ui",
      "!examples/shadcn-reference/src/hooks/use-highlighted-code.ts",
      "!examples/shadcn-reference/src/lib/highlighter.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "jsxRuntime": "transparent"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/remix-ai-elements/src/**/*.tsx",
        "examples/playground/app/ui/public/**/*.tsx",
        "tests/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off",
            "useAriaPropsSupportedByRole": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/shadcn-reference/src/app.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "examples/playground/app/ui/public/app.tsx",
        "examples/playground/app/ui/public/components/playground-shell.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useValidAnchor": "off"
          }
        }
      }
    }
  ]
}
